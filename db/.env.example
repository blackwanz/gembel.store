# Copy this file to db/.env and fill in your real value.
# db/.env is already gitignored (see .gitignore: .env / .env.*) -- it will
# never be committed, unlike hardcoding this into migrate.sh itself.
#
# Get the connection string from: Supabase Dashboard -> Project Settings ->
# Database -> Connection string -> pick "Session pooler", NOT "Direct
# connection" and NOT "Transaction pooler":
#   - Direct connection is IPv6-only unless you've paid for Supabase's IPv4
#     add-on -- most VPS providers don't give you outbound IPv6, so this
#     just hangs/times out from a VPS ("Network is unreachable").
#   - Transaction pooler (port 6543) is IPv4, but pools per-statement --
#     db/migrate.sh's pg_advisory_lock needs one held for its whole
#     session, which breaks under transaction-mode pooling.
#   - Session pooler (port 5432, host like aws-0-<region>.pooler.supabase.com)
#     is IPv4 AND keeps one real session per connection, so both the lock
#     and everything else here work the same as a direct connection would.
# If your password has special characters (# @ : / % ?), percent-encode
# them -- e.g. a literal # becomes %23.

SUPABASE_DB_URL=postgresql://user:pass@host:5432/postgres
