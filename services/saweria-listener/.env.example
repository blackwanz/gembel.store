# Copy to .env (gitignored) and fill in real values. Never commit the service role key.

# Supabase Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase Project Settings -> API -> service_role key (NOT the anon key -- this needs to
# bypass RLS to update other users' payment_requests rows).
SUPABASE_SERVICE_ROLE_KEY=

# Saweria dashboard -> Widget/Overlay -> the streamKey embedded in your alert-box widget URL
# (the long id after ?streamKey= or in the widget URL path). Not your login password.
SAWERIA_STREAM_KEY=

# Unofficial, reverse-engineered endpoint used by Saweria's own OBS alert-box widget -- a plain
# WebSocket (not Socket.IO), confirmed via DevTools on 2026-09-06. Can still drift without notice
# since it's undocumented -- see README.md's "Verifying the endpoint" section if this stops
# working.
SAWERIA_SOCKET_URL=wss://events.saweria.co/stream

# How often (ms) to sweep payment_requests for pending rows whose expires_at has passed and
# flip them to 'expired' so their amount can be reused.
SWEEP_INTERVAL_MS=60000
